# DeltaDrift secrets. Copy to `.env` (git-ignored) and fill in.
# Real environment variables take precedence over this file.
# Only the variables for venues you enable are required.

# --- cTrader Open API (default live venue; free with a demo account) ---
# 1. Create a cTrader ID and a free demo account at a cTrader broker (e.g. Pepperstone, IC Markets).
# 2. Register an app at https://openapi.ctrader.com/apps -> Credentials gives client id/secret.
# 3. In the app's Playground, authorise your demo account (scope "trading" or "accounts") -> access token.
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
CTRADER_ACCESS_TOKEN=
# Access tokens last ~30 days; regenerate in the Playground when the engine reports it invalid.
# Optional: pin an account. Leave empty = first demo account on the token.
# This is cTrader's ctidTraderAccountId (NOT your broker login number); the engine
# prints it on connect: "[feed:ctrader] using Demo account: CTRADER_ACCOUNT_ID=..."
CTRADER_ACCOUNT_ID=
# demo (default) | live
CTRADER_ENV=demo

# --- Alpaca (optional; free tier = real-time IEX only, 30 symbols) ---
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
# "iex" (free) or "sip" (paid)
ALPACA_STOCK_FEED=iex

# --- FRED macro data (Sprint 3) — https://fred.stlouisfed.org/docs/api/api_key.html ---
FRED_API_KEY=
